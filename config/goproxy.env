# Go 模块代理配置（在所有构建脚本中 source 此文件）
# 绕过 Go 模块代理被封锁的问题

# 主代理：七牛云（goproxy.cn）
export GOPROXY="https://goproxy.cn,https://goproxy.io,https://mirrors.aliyun.com/goproxy/,direct"

# 禁用 sumcheck（避免 sum.golang.org 连接超时）
export GONOSUMCHECK="*"
export GONOSUMDB="*"
export GONOPROXY=""

# 私有模块（如有）
export GOPRIVATE=""

# 设置 Go 缓存目录（使用较大的磁盘空间）
export GOMODCACHE="${GOMODCACHE:-$HOME/go/pkg/mod}"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
